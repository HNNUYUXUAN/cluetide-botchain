{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HNNUYUXUAN/cluetide-botchain/schemas/acceptance-v2.json",
  "title": "acceptance-v2",
  "type": "object",
  "required": [
    "schema",
    "deployment",
    "task_id",
    "version_id",
    "attempt_id",
    "observed_at",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "cluetide.acceptance-bundle.v2"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "chain_id",
        "contract_address"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        }
      }
    },
    "task_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "version_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "observed_at": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
