{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HNNUYUXUAN/cluetide-botchain/schemas/manifest-v2.json",
  "title": "manifest-v2",
  "type": "object",
  "required": [
    "schema",
    "deployment",
    "task_id",
    "version_id",
    "parent_version_id",
    "summary",
    "source_reference",
    "test_evidence",
    "artifact",
    "target_id",
    "operation",
    "target",
    "policy_version",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "cluetide.release-manifest.v2"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "chain_id",
        "contract_address"
      ],
      "properties": {
        "protocol_version": {
          "const": 2
        },
        "chain_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        }
      }
    },
    "task_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "version_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "parent_version_id": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "source_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "test_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "filename",
        "bytes",
        "sha256"
      ],
      "properties": {
        "filename": {
          "const": "artifact.html"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768
        },
        "sha256": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "target_id": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "operation": {
      "const": "publish_static"
    },
    "target": {
      "const": "demo-site"
    },
    "policy_version": {
      "const": "cluetide.demo-release.v2"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
